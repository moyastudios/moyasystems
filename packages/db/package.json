    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "@types/pg": "8.23.1"
  }
}
