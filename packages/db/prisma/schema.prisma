// Westbridge Staff System schema.
// Runtime connections use per-app Postgres roles (see sql/roles.sql); migrations use the owner role.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum CaseType {
  WARN
  KICK
  SERVERBAN
  TIMEBAN
  GAMEBAN
}

enum CaseSource {
  DISCORD
  IN_GAME
  DASHBOARD
}

enum LoaStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

enum ChallengePurpose {
  OAUTH_STATE
  CLAIM
  PASSKEY_REGISTER
  PASSKEY_LOGIN
  STEP_UP
}

model User {
  id             String    @id @default(uuid())
  discordId      String    @unique @map("discord_id")
  robloxId       BigInt?   @unique @map("roblox_id")
  robloxUsername String?   @map("roblox_username")
  linkedAt       DateTime? @map("linked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  staff          Staff?

  @@map("users")
}

/// Stores a SHA-256 of the code, never the code itself.
model LinkCode {
  codeHash  String    @id @map("code_hash")
  discordId String    @unique @map("discord_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("link_codes")
}

model Rank {
  id              String       @id @default(uuid())
  name            String       @unique
  /// Higher = more senior.
  order           Int          @unique
  discordRoleId   String?      @map("discord_role_id")
  robloxGroupRank Int?         @map("roblox_group_rank")
  staff           Staff[]
  permissions     Permission[]
  quotaRule       QuotaRule?

  @@map("ranks")
}

model Staff {
  id           String     @id @default(uuid())
  userId       String     @unique @map("user_id")
  rankId       String     @map("rank_id")
  joinedAt     DateTime   @default(now()) @map("joined_at")
  active       Boolean    @default(true)
  user         User       @relation(fields: [userId], references: [id])
  rank         Rank       @relation(fields: [rankId], references: [id], onDelete: Restrict)
  cases        Case[]     @relation("CaseModerator")
  revokedCases Case[]     @relation("CaseRevoker")
  helpCalls    HelpCall[]
  loas         Loa[]      @relation("LoaStaff")
  loasApproved Loa[]      @relation("LoaApprover")

  @@map("staff")
}

model Permission {
  command       String  @id
  minRankId     String  @map("min_rank_id")
  /// Seconds; null = no cap.
  maxDuration   Int?    @map("max_duration")
  needsApproval Boolean @default(false) @map("needs_approval")
  minRank       Rank    @relation(fields: [minRankId], references: [id], onDelete: Restrict)

  @@map("permissions")
}

model Case {
  id             String     @id @default(uuid())
  caseNo         Int        @unique @default(autoincrement()) @map("case_no")
  type           CaseType
  targetRobloxId BigInt     @map("target_roblox_id")
  moderatorId    String     @map("moderator_id")
  reason         String
  evidenceUrl    String?    @map("evidence_url")
  /// Seconds.
  duration       Int?
  expiresAt      DateTime?  @map("expires_at")
  /// Serverbans apply to this server only.
  serverJobId    String?    @map("server_job_id")
  source         CaseSource
  revokedAt      DateTime?  @map("revoked_at")
  revokedById    String?    @map("revoked_by_id")
  revokeReason   String?    @map("revoke_reason")
  createdAt      DateTime   @default(now()) @map("created_at")
  moderator      Staff      @relation("CaseModerator", fields: [moderatorId], references: [id], onDelete: Restrict)
  revokedBy      Staff?     @relation("CaseRevoker", fields: [revokedById], references: [id])

  @@index([targetRobloxId, createdAt])
  @@index([moderatorId, createdAt])
  @@map("cases")
}

model HelpCall {
  id                String    @id @default(uuid())
  /// Adonis call id; makes duplicate reports idempotent.
  externalId        String    @unique @map("external_id")
  staffId           String    @map("staff_id")
  requesterRobloxId BigInt    @map("requester_roblox_id")
  serverJobId       String    @map("server_job_id")
  acceptedAt        DateTime  @map("accepted_at")
  closedAt          DateTime? @map("closed_at")
  counted           Boolean   @default(false)
  staff             Staff     @relation(fields: [staffId], references: [id])

  @@index([staffId, acceptedAt])
  @@map("help_calls")
}

model QuotaRule {
  id             String @id @default(uuid())
  rankId         String @unique @map("rank_id")
  minHelpCalls   Int    @map("min_help_calls")
  minActions     Int    @map("min_actions")
  minEvents      Int    @map("min_events")
  minCallSeconds Int    @map("min_call_seconds")
  /// Max counted calls per requester per staff member per day.
  repeatCap      Int    @map("repeat_cap")
  rank           Rank   @relation(fields: [rankId], references: [id], onDelete: Cascade)

  @@map("quota_rules")
}

model Loa {
  id           String    @id @default(uuid())
  staffId      String    @map("staff_id")
  starts       DateTime
  ends         DateTime
  reason       String
  status       LoaStatus @default(PENDING)
  approvedById String?   @map("approved_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  staff        Staff     @relation("LoaStaff", fields: [staffId], references: [id])
  approvedBy   Staff?    @relation("LoaApprover", fields: [approvedById], references: [id])

  @@map("loa")
}

/// value is JSON text, or "v1:<keyId>:<iv>:<tag>:<ciphertext>" when encrypted.
model Setting {
  key       String   @id
  value     String
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("settings")
}

model ConfigVersion {
  version        Int      @id @default(autoincrement())
  /// Discord ID of the owner.
  changedBy      String   @map("changed_by")
  /// Secret values appear as "changed", never as values.
  diff           Json
  /// Full config after the change (secrets still encrypted); used for rollback.
  snapshot       Json
  rolledBackFrom Int?     @map("rolled_back_from")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("config_versions")
}

model Passkey {
  id           String    @id @default(uuid())
  discordId    String    @map("discord_id")
  credentialId String    @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  counter      BigInt    @default(0)
  transports   String[]
  nickname     String?
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  @@index([discordId])
  @@map("passkeys")
}

model AuditLog {
  id         BigInt    @id @default(autoincrement())
  /// "discord:<id>" | "game:<jobId>" | "owner:<id>" | "system"
  actor      String
  action     String
  payload    Json
  ip         String?
  mirroredAt DateTime? @map("mirrored_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([mirroredAt])
  @@map("audit_log")
}

// ── Security support tables ──

model DashboardSession {
  /// SHA-256 of the cookie token.
  idHash            String    @id @map("id_hash")
  discordId         String    @map("discord_id")
  passkeyVerifiedAt DateTime? @map("passkey_verified_at")
  stepUpAt          DateTime? @map("step_up_at")
  csrfSecret        String    @map("csrf_secret")
  ip                String?
  userAgent         String?   @map("user_agent")
  createdAt         DateTime  @default(now()) @map("created_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")

  @@index([discordId])
  @@map("dashboard_sessions")
}

model AuthChallenge {
  id        String           @id @default(uuid())
  purpose   ChallengePurpose
  discordId String?          @map("discord_id")
  challenge String
  expiresAt DateTime         @map("expires_at")
  usedAt    DateTime?        @map("used_at")

  @@index([expiresAt])
  @@map("auth_challenges")
}

model OwnerInvite {
  id           String    @id @default(uuid())
  tokenHash    String    @unique @map("token_hash")
  forDiscordId String    @map("for_discord_id")
  createdBy    String    @map("created_by")
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("owner_invites")
}

model GameSession {
  id            String   @id @default(uuid())
  jobId         String   @map("job_id")
  placeId       BigInt   @map("place_id")
  keyCiphertext String   @map("key_ciphertext")
  createdAt     DateTime @default(now()) @map("created_at")
  expiresAt     DateTime @map("expires_at")

  @@index([jobId])
  @@index([expiresAt])
  @@map("game_sessions")
}

model RequestNonce {
  nonce     String   @id
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("request_nonces")
}

model IdempotencyKey {
  key       String   @id
  status    Int
  response  Json
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("idempotency_keys")
}

model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime @map("window_start")

  @@map("rate_limit_buckets")
}

model ConnectivityCheck {
  id          String    @id @default(uuid())
  /// "api_to_game" | "game_to_api"
  direction   String
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  detail      String?

  @@map("connectivity_checks")
}
