{
  "name": "westbridge",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @westbridge/db generate",
    "db:migrate": "pnpm --filter @westbridge/db migrate:deploy",
    "db:roles": "pnpm --filter @westbridge/db roles"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "vitest": "5.0.5"
  }
}
