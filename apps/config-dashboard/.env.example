# apps/config-dashboard — set these in the SEPARATE "westbridge-config" Vercel project. Never commit real values.

# Neon connection string for the wb_config role (pooled host). NOT the owner role, NOT wb_api.
DATABASE_URL=postgresql://wb_config:CHANGE_ME@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Same 32-byte key as the API (openssl rand -base64 32), so the API can read secrets saved here.
SETTINGS_ENCRYPTION_KEY=
SETTINGS_ENCRYPTION_KEY_ID=k1

# One-time setup token for wizard step 1 (openssl rand -base64 48). Useless once claimed.
SETUP_TOKEN=

# Comma-separated Discord user IDs allowed to sign in.
OWNER_DISCORD_IDS=

# Discord developer portal → your application. Redirect: https://config.moya-studios.xyz/auth/discord/callback
DISCORD_APP_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

PUBLIC_ORIGIN=https://config.moya-studios.xyz
WEBAUTHN_RP_ID=config.moya-studios.xyz
