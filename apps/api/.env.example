# apps/api — set these in the "westbridge-api" Vercel project. Never commit real values.

# Neon connection string for the wb_api role (pooled host). NOT the owner role.
DATABASE_URL=postgresql://wb_api:CHANGE_ME@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require

# 32 random bytes, base64 (openssl rand -base64 32). Must match the config dashboard's value.
SETTINGS_ENCRYPTION_KEY=
SETTINGS_ENCRYPTION_KEY_ID=k1
# Only during a key rotation:
# SETTINGS_ENCRYPTION_KEY_PREVIOUS=
# SETTINGS_ENCRYPTION_KEY_PREVIOUS_ID=

# Discord developer portal → your application
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
