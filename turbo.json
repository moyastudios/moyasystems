{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "TEST_API_DATABASE_URL",
    "TEST_CONFIG_DATABASE_URL",
    "MIGRATE_DATABASE_URL"
  ],
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "typecheck": {},
    "test": {
      "cache": false
    }
  }
}
